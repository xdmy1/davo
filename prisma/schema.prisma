generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ===== Geografie =====

model Country {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  flag      String?
  cities    City[]

  // Program săptămânal pentru cursele DUS spre țara asta (din Moldova).
  // Toate optionale — dacă lipsesc, țara n-are program activ și nu se generează curse.
  // Weekday: 0=duminică ... 6=sâmbătă (convenția JS Date.getDay()).
  // Time: "HH:mm" în ora locală Europe/Chisinau.
  outboundWeekday       Int?
  outboundTime          String?
  outboundDurationHours Float?

  // Program săptămânal pentru cursele RETUR (din țara asta spre Moldova).
  returnWeekday         Int?
  returnTime            String?
  returnDurationHours   Float?

  createdAt DateTime @default(now())
}

model City {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  isOrigin  Boolean  @default(false) // true pentru orașele de plecare din Moldova
  countryId String
  country   Country  @relation(fields: [countryId], references: [id])

  originRoutes      Route[] @relation("RouteOrigin")
  destinationRoutes Route[] @relation("RouteDestination")

  createdAt DateTime @default(now())

  @@index([countryId])
  @@index([isOrigin])
}

// ===== Operațiuni =====

model Route {
  id                String   @id @default(uuid())
  originCityId      String
  destinationCityId String
  originCity        City     @relation("RouteOrigin", fields: [originCityId], references: [id])
  destinationCity   City     @relation("RouteDestination", fields: [destinationCityId], references: [id])

  basePrice        Float
  currency         String   @default("EUR")
  description      String?
  seoSlug          String?
  pageSlug         String?
  active           Boolean  @default(true)
  weeklyDepartures Int      @default(2)

  trips            Trip[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([originCityId, destinationCityId])
  @@index([active])
}

model Bus {
  id         String   @id @default(uuid())
  plate      String   @unique
  label      String
  model      String
  year       Int
  totalSeats Int
  layoutJson String   // JSON serializat: { rows, cols, cells: SeatKind[] }
  active     Boolean  @default(true)

  trips      Trip[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Trip {
  id          String   @id @default(uuid())
  routeId     String
  route       Route    @relation(fields: [routeId], references: [id])
  busId       String
  bus         Bus      @relation(fields: [busId], references: [id])

  departureAt DateTime
  arrivalAt   DateTime
  status      String   @default("scheduled") // scheduled|boarding|en_route|completed|cancelled
  capacity    Int
  notes       String?

  seatBookings    SeatBooking[]
  bookings        Booking[]     @relation("TripBookings")
  returnBookings  Booking[]     @relation("TripReturnBookings")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([departureAt])
  @@index([status])
  @@index([routeId])
}

model SeatBooking {
  id            String   @id @default(uuid())
  tripId        String
  trip          Trip     @relation(fields: [tripId], references: [id])
  seatNumber    Int      // numărul din layout-ul Bus
  bookingId     String?
  booking       Booking? @relation(fields: [bookingId], references: [id])
  holdExpiresAt DateTime?
  createdAt     DateTime @default(now())

  @@unique([tripId, seatNumber])
  @@index([bookingId])
}

// ===== Clienți =====

model Client {
  id        String   @id @default(uuid())
  email     String   @unique
  firstName String
  lastName  String
  phone     String
  vip       Boolean  @default(false)
  notes     String?

  bookings  Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
}

// ===== Rezervări (existent + relații noi opționale) =====

model Booking {
  id            String    @id @default(uuid())
  bookingNumber String    @unique
  type          String
  status        String    @default("pending")

  tripType      String?
  departureCity String
  arrivalCity   String
  departureDate DateTime
  returnDate    DateTime?

  firstName     String
  lastName      String
  email         String
  phone         String

  adults        Int       @default(1)
  children      Int       @default(0)

  parcelWeight  Float?
  parcelDetails String?

  price         Float
  currency      String    @default("EUR")
  paymentStatus String    @default("pending")
  payMethod     String?   // card_on_pickup | cash_on_pickup
  paidAt        DateTime?

  // Confirmare/anulare prin link din email-ul de confirmare
  passengerResponse   String?   // confirmed | cancelled
  passengerResponseAt DateTime?

  ticketUrl     String?
  qrCode        String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  confirmedAt   DateTime?

  emailSent     Boolean   @default(false)
  emailSentAt   DateTime?

  // Panou operatori (davo-operatori). Aditiv: rândurile vechi primesc source='site',
  // restul rămân null. Nimic existent nu se schimbă, davo nu setează aceste câmpuri.
  source         String    @default("site") // site | operator | admin
  manualBusId    String?                     // Bus.id atribuit manual din panoul operatorilor (grupare pe cursă fizică). Aditiv/nullable — davo îl ignoră.
  createdById    String?                     // Operator.id (gol pentru rezervări de pe site)
  createdByName  String?                     // snapshot nume (afișat și pe davo, fără join)
  createdBy      Operator? @relation(fields: [createdById], references: [id])
  archivedAt     DateTime?                    // cursa a trecut → iese din panou, rămâne salvată

  // Notiță internă a operatorului (Observații din formularul de rezervare).
  notes          String?
  // Furnizor / agenție parteneră care ne-a adus pasagerul (ex. "autocar.md").
  // Null = client direct. Folosit la raportul lunar de comision (/admin/furnizori).
  furnizor       String?
  // Îmbarcare (scanner QR din panoul operatorilor): cine/când + surplus bagaj.
  boardedAt      DateTime?
  boardedBy      String?
  baggageSurplus String?

  review         Review?

  // relații noi, OPȚIONALE (pentru a nu sparge bookings existente)
  clientId       String?
  client         Client?   @relation(fields: [clientId], references: [id])
  tripId         String?
  trip           Trip?     @relation("TripBookings", fields: [tripId], references: [id])
  returnTripId   String?
  returnTrip     Trip?     @relation("TripReturnBookings", fields: [returnTripId], references: [id])

  seatBookings   SeatBooking[]
  emailJobs      EmailJob[]

  @@index([bookingNumber])
  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@index([clientId])
  @@index([tripId])
  @@index([source])
  @@index([archivedAt])
  @@index([createdById])
  @@index([furnizor])
}

// ===== Operatori (panou davo-operatori — login cu PIN 4 cifre) =====

model Operator {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique // adrian, olga, dumitru, alexandru, ghenadie, catalin, gabriela
  pinHash   String             // bcrypt al PIN-ului de 4 cifre
  role      String    @default("operator") // operator | supervisor
  active    Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Chei de secțiuni din panoul operatorilor. Lista goală înseamnă „folosește
  // presetul rolului", ca operatorii existenți să rămână exact cum sunt azi.
  permissions String[] @default([])

  bookings  Booking[]
}

// ===== Emailuri automate =====

model EmailJob {
  id        String   @id @default(uuid())
  type      String   // confirmation | reminder_24h | reminder_2h | cancellation
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id])

  sendAt    DateTime
  sentAt    DateTime?
  status    String   @default("scheduled") // scheduled|queued|sent|failed|cancelled
  attempts  Int      @default(0)
  lastError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sendAt, status])
  @@index([bookingId])
}

model EmailLog {
  id          String    @id @default(uuid())
  to          String
  subject     String
  template    String
  status      String
  relatedId   String?
  error       String?
  sentAt      DateTime  @default(now())
  deliveredAt DateTime?
  openedAt    DateTime?

  @@index([to])
  @@index([relatedId])
  @@index([sentAt])
}

// ===== Admin =====

model AdminUser {
  id        String    @id @default(uuid())
  email     String    @unique
  name      String
  password  String
  role      String    @default("admin")
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Dezactivare fără ștergere: rezervările și jurnalul rămân legate de contul
  // vechi, dar autentificarea e refuzată.
  active      Boolean  @default(true)
  // Chei de secțiuni din catalogul lib/permissions.ts. Lista goală înseamnă
  // „folosește presetul rolului" — de asta conturile existente nu se schimbă.
  permissions String[] @default([])
}

// Jurnal de audit pentru panoul „Conturi & Acces": cine, ce a schimbat și unde.
// Separat de conturile propriu-zise ca să supraviețuiască ștergerii lor.
model AccountAudit {
  id         String   @id @default(uuid())
  actorEmail String
  action     String   // create | update | delete | password | permissions | activate | deactivate | gate_pin | unlock_fail
  system     String   // davo | rezervari | colete | gate
  targetId   String?
  targetName String
  details    String?  // JSON scurt, FĂRĂ parole sau PIN-uri
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model Settings {
  id    String @id @default("1")
  key   String @unique
  value String
}

// ===== Rezervor motorină (fuel) =====
// Pagină admin-only: gestionăm un rezervor mare de motorină care alimentează
// autobuzele/autocarele. `FuelTank` e un singleton (id="1"), iar fiecare
// operație (adăugare în rezervor sau alimentare vehicul) e un `FuelEntry`.

model FuelTank {
  id        String   @id @default("1") // singleton
  capacity  Float    @default(9000)    // capacitate maximă (litri)
  liters    Float    @default(0)       // stoc curent (litri)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FuelEntry {
  id            String   @id @default(uuid())
  kind          String   // refill = adăugare în rezervor | dispense = alimentare vehicul
  liters        Float    // întotdeauna pozitiv; `kind` decide semnul asupra stocului
  pricePerLiter Float?   // preț achiziție per litru (lei), doar la reumplere; total = liters * pricePerLiter
  plate         String?  // număr înmatriculare (la alimentare vehicul)
  vehicle       String?  // ce mașină / etichetă
  notes         String?  // notițe (mașină personală / a altcuiva etc.)
  balanceAfter  Float    // stocul rezervorului după această operație (snapshot audit)
  createdByName String?  // numele adminului care a înregistrat
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([kind])
}

// Recenzie lăsată de client după cursă (email trimis la 2 zile de la sosire,
// link cu token → pagina /recenzie cu numele + cursa precompletate).
model Review {
  id            String   @id @default(uuid())
  bookingId     String   @unique
  booking       Booking  @relation(fields: [bookingId], references: [id])
  bookingNumber String
  name          String
  rating        Int      // 1..5 stele
  comment       String?
  tripLabel     String?  // "Bonn → Chișinău · 9 aug 2026" (snapshot pentru afișare)
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

// ===== Evidență mentenanță autobuze =====
// Un „punct de mentenanță" recurent per vehicul (ex: „Ulei motor la 30.000 km").
// Odometrul curent se ia LIVE din Gelios (counters.mileage), deci nu-l stocăm —
// calculăm km rămași = intervalKm − (odometruGelios − lastServiceKm).
// Cheia stabilă e `geliosUnitId` (id-ul unității GPS), nu placa (care se poate
// schimba). `vehicleName` e doar snapshot pentru afișare.
model MaintenanceItem {
  id            String   @id @default(uuid())
  geliosUnitId  Int      // id unitate Gelios (identificator stabil)
  vehicleName   String   // snapshot placă/nume (ex: "DAW 077")
  type          String   // ex: "Ulei motor + filtru", "ITP", "Asigurare RCA"
  intervalKm    Int?     // schimbă la fiecare X km (opțional)
  intervalDays  Int?     // și/sau la fiecare X zile (ITP, asigurare, tahograf)
  lastServiceKm Float?   // odometru (km) la ultima efectuare — snapshot din Gelios
  lastServiceAt DateTime // data ultimei efectuări
  notes         String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  logs          MaintenanceLog[]

  @@index([geliosUnitId])
  @@index([active])
}

// Istoricul efectuărilor (fiecare dată când s-a făcut service-ul acelui punct).
model MaintenanceLog {
  id        String          @id @default(uuid())
  itemId    String
  item      MaintenanceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  serviceKm Float?          // odometru (km) la momentul efectuării
  serviceAt DateTime
  laborCost Float?          // preț manoperă
  partsCost Float?          // preț piese
  cost      Float?          // total (manoperă + piese) — snapshot pentru sumar rapid
  notes     String?
  createdByName String?     // adminul care a înregistrat
  createdAt DateTime        @default(now())

  @@index([itemId])
}
